{
  "name": "pi-my-compact-ui",
  "version": "0.4.0",
  "description": "Compact tree-shaped reasoning and tool-call UI for the Pi Coding Agent",
  "author": "cybershape",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cybershape/pi-my-compact-ui.git"
  },
  "homepage": "https://github.com/cybershape/pi-my-compact-ui#readme",
  "bugs": {
    "url": "https://github.com/cybershape/pi-my-compact-ui/issues"
  },
  "type": "module",
  "keywords": [
    "terminal-ui",
    "tui"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --packages=external --sourcemap && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
