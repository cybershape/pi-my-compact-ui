{
  "name": "pi-my-compact-ui",
  "version": "0.4.8",
  "description": "Compact tree-shaped reasoning and tool-call UI for the Pi Coding Agent",
  "author": "cybershape",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cybershape/pi-my-compact-ui.git"
  },
  "homepage": "https://github.com/cybershape/pi-my-compact-ui#readme",
  "bugs": {
    "url": "https://github.com/cybershape/pi-my-compact-ui/issues"
  },
  "type": "module",
  "keywords": [
    "terminal-ui",
    "tui"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "dist/extension.ts",
    "dist/extension.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./dist/extension.ts"
    ]
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/extension.ts --packages=external --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@earendil-works/pi-tui": "^1.0.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@earendil-works/pi-tui": "^1.0.3",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
